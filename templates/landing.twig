{% extends 'layout/base.twig' %}

{% block title %}{{ page_title ?: trans('landing.admin.title') }} – {{ site_name }}{% endblock %}

{% block meta_description %}{{ page_meta_description }}{% endblock %}

{% block head %}
    <link rel="stylesheet" href="{{ ext_asset('landing', 'landing.css') }}">
    <link rel="stylesheet" href="{{ url('/landing/blocks.css') }}?v={{ blocks_css_version }}">
    {% if can_edit %}
        {# The core's own inline-edit scripts - loaded only here, not sitewide, since edit_mode()
           elsewhere checks a different permission than this addon's own. They work on any
           [data-field]/[data-block-id] markup, this addon's own included - no script of ours. #}
        <script src="{{ admin_asset('editor.js') }}" defer></script>
        <script src="{{ admin_asset('inline-edit.js') }}" defer></script>
    {% endif %}
{% endblock %}

{% block content %}
{% include '@landing/inline/_bar.twig' %}

{% if not published and can_edit %}
    <p class="flash flash-error">{{ trans('landing.admin.draft_notice') }}</p>
{% endif %}

<div class="landing-page">
    {% for block in blocks %}
        {% if edit_mode %}
            {% include '@landing/inline/_block.twig' %}
        {% elseif block.enabled %}
            {% include '@landing/_block_' ~ block.type ~ '.twig' %}
        {% endif %}
    {% endfor %}
</div>
{% endblock %}
