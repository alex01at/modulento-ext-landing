{# Receives block: heading, intro, items (each: index, tag, heading, text). Every item's own
   fields are edited on the spot, by its position. #}
<section class="landing-block landing-block-cards">
    {% if block.heading or edit_mode %}<h2 data-field="heading">{{ block.heading }}</h2>{% endif %}
    {% if block.intro or edit_mode %}<p class="landing-intro" data-field="intro">{{ block.intro }}</p>{% endif %}
    <div class="landing-cards">
        {% for item in block.items %}
            <article class="landing-card">
                {% if item.tag or edit_mode %}<span class="landing-card-tag" data-field="items.{{ item.index }}.tag">{{ item.tag }}</span>{% endif %}
                <h3 data-field="items.{{ item.index }}.heading">{{ item.heading }}</h3>
                {% if item.text or edit_mode %}<p data-field="items.{{ item.index }}.text">{{ item.text }}</p>{% endif %}
            </article>
        {% endfor %}
    </div>
</section>
