{# The editable fields of one block, by type - shared between the full admin form
   (admin/edit.twig) and the "Bearbeiten" panel of the inline, on-page editor
   (inline/_block.twig). Receives id, block (as stored - per-locale maps), locale, max_items. #}
{% if block.type == 'hero' %}
    {% include '@landing/admin/_field.twig' with {id: id, field: 'eyebrow', value: block.eyebrow[locale] ?? ''} only %}
    {% include '@landing/admin/_field.twig' with {id: id, field: 'heading', value: block.heading[locale] ?? ''} only %}
    {% include '@landing/admin/_field.twig' with {id: id, field: 'subheading', value: block.subheading[locale] ?? ''} only %}
    {% include '@landing/admin/_field.twig' with {id: id, field: 'primary_label', value: block.primary_label[locale] ?? ''} only %}
    {% include '@landing/admin/_field.twig' with {id: id, field: 'primary_url', value: block.primary_url ?? '', plain: true} only %}
    {% include '@landing/admin/_field.twig' with {id: id, field: 'secondary_label', value: block.secondary_label[locale] ?? ''} only %}
    {% include '@landing/admin/_field.twig' with {id: id, field: 'secondary_url', value: block.secondary_url ?? '', plain: true} only %}
{% elseif block.type == 'stats' %}
    {% include '@landing/admin/_field.twig' with {id: id, field: 'heading', value: block.heading[locale] ?? ''} only %}
    {% for n in 0..max_items - 1 %}
        <div class="field-grid">
            {% include '@landing/admin/_item_field.twig' with {id: id, n: n, field: 'value', value: block.items[n].value ?? '', plain: true} only %}
            {% include '@landing/admin/_item_field.twig' with {id: id, n: n, field: 'label', value: block.items[n].label[locale] ?? ''} only %}
        </div>
    {% endfor %}
{% elseif block.type == 'cards' %}
    {% include '@landing/admin/_field.twig' with {id: id, field: 'heading', value: block.heading[locale] ?? ''} only %}
    {% include '@landing/admin/_field.twig' with {id: id, field: 'intro', value: block.intro[locale] ?? ''} only %}
    {% for n in 0..max_items - 1 %}
        <fieldset class="home-language">
            <legend>{{ trans('landing.admin.item', {number: n + 1}) }}</legend>
            <div class="field-grid">
                {% include '@landing/admin/_item_field.twig' with {id: id, n: n, field: 'tag', value: block.items[n].tag[locale] ?? ''} only %}
                {% include '@landing/admin/_item_field.twig' with {id: id, n: n, field: 'heading', value: block.items[n].heading[locale] ?? ''} only %}
            </div>
            <div class="field">
                <label for="field-{{ id }}-{{ n }}-text">{{ trans('landing.field.text') }}</label>
                <textarea id="field-{{ id }}-{{ n }}-text" name="blocks[{{ id }}][items][{{ n }}][text]" rows="2" maxlength="200">{{ block.items[n].text[locale] ?? '' }}</textarea>
            </div>
        </fieldset>
    {% endfor %}
{% elseif block.type == 'text' %}
    {% include '@landing/admin/_field.twig' with {id: id, field: 'heading', value: block.heading[locale] ?? ''} only %}
    <div class="field">
        <label for="field-{{ id }}-body">{{ trans('landing.field.body') }}</label>
        <textarea id="field-{{ id }}-body" name="blocks[{{ id }}][body]" rows="10" lang="{{ locale }}" data-editor="{{ editor() }}">{{ block.body[locale] ?? '' }}</textarea>
    </div>
{% elseif block.type == 'cta' %}
    {% include '@landing/admin/_field.twig' with {id: id, field: 'heading', value: block.heading[locale] ?? ''} only %}
    {% include '@landing/admin/_field.twig' with {id: id, field: 'text', value: block.text[locale] ?? ''} only %}
    {% include '@landing/admin/_field.twig' with {id: id, field: 'button_label', value: block.button_label[locale] ?? ''} only %}
    {% include '@landing/admin/_field.twig' with {id: id, field: 'button_url', value: block.button_url ?? '', plain: true} only %}
    {% include '@landing/admin/_field.twig' with {id: id, field: 'secondary_label', value: block.secondary_label[locale] ?? ''} only %}
    {% include '@landing/admin/_field.twig' with {id: id, field: 'secondary_url', value: block.secondary_url ?? '', plain: true} only %}
{% endif %}

{# Not tied to any language, unlike every field above - a block's own look, the same idea the
   core's own home-page blocks already offer (background), plus a font and a text colour of its
   own; "data-background-toggle"/"data-background-field" is the core's own background-field.js,
   already loaded on every administration page. #}
<fieldset>
    <legend>{{ trans('core.home.background') }}</legend>
    <div class="field">
        <label for="bg-type-{{ id }}">{{ trans('core.home.background_type') }}</label>
        <select id="bg-type-{{ id }}" name="blocks[{{ id }}][settings][background_type]" data-background-toggle>
            <option value="" {{ (block.settings.background_type ?? '') == '' ? 'selected' }}>{{ trans('core.home.background_option_none') }}</option>
            <option value="color" {{ (block.settings.background_type ?? '') == 'color' ? 'selected' }}>{{ trans('core.home.background_option_color') }}</option>
            <option value="gradient" {{ (block.settings.background_type ?? '') == 'gradient' ? 'selected' }}>{{ trans('core.home.background_option_gradient') }}</option>
            <option value="image" {{ (block.settings.background_type ?? '') == 'image' ? 'selected' }}>{{ trans('core.home.background_option_image') }}</option>
        </select>
    </div>
    <div class="field" data-background-field="color gradient">
        <label for="bg-color-{{ id }}">{{ trans('core.home.background_color') }}</label>
        <input id="bg-color-{{ id }}" type="color" name="blocks[{{ id }}][settings][background_color]" value="{{ block.settings.background_color ?? '#ffffff' }}">
    </div>
    <div class="field" data-background-field="gradient">
        <label for="bg-color2-{{ id }}">{{ trans('core.home.background_color2') }}</label>
        <input id="bg-color2-{{ id }}" type="color" name="blocks[{{ id }}][settings][background_color2]" value="{{ block.settings.background_color2 ?? '#ffffff' }}">
    </div>
    <div class="field" data-background-field="image">
        <label for="bg-media-{{ id }}">{{ trans('core.home.picture') }}</label>
        <select id="bg-media-{{ id }}" name="blocks[{{ id }}][settings][background_media]">
            <option value="">{{ trans('core.home.picture_none') }}</option>
            {% for picture in library_pictures() %}
                <option value="{{ picture.url }}" {{ picture.url == (block.settings.background_media ?? '') ? 'selected' }}>{{ picture.title ?: picture.url }}</option>
            {% endfor %}
        </select>
    </div>
</fieldset>
<fieldset>
    <legend>{{ trans('landing.field.typography') }}</legend>
    <div class="field-grid">
        <div class="field">
            <label for="font-{{ id }}">{{ trans('core.design.font') }}</label>
            <select id="font-{{ id }}" name="blocks[{{ id }}][settings][font]">
                <option value="">{{ trans('landing.field.font_default') }}</option>
                {% for key in ['system', 'serif', 'humanist', 'mono'] %}
                    <option value="{{ key }}" {{ (block.settings.font ?? '') == key ? 'selected' }}>{{ trans('core.design.font.' ~ key) }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="field">
            <label for="text-color-{{ id }}">{{ trans('core.design.text') }}</label>
            <input id="text-color-{{ id }}" type="color" name="blocks[{{ id }}][settings][text_color]" value="{{ block.settings.text_color ?? '#1c2430' }}">
        </div>
    </div>
</fieldset>
